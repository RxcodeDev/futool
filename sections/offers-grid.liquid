<section class="offers">
  {%- for block in section.blocks -%}
    <a
      href="{{ block.settings.link | default: '#' }}"
      class="img__offers"
      {{ block.shopify_attributes }}
    >
      {%- if block.settings.image != blank -%}
        <picture>
          {%- if block.settings.image_mobile != blank -%}
            <source media="(max-width: 640px)" srcset="{{ block.settings.image_mobile | image_url: width: 750 }}" type="image/webp">
          {%- endif -%}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
          >
        </picture>
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Cuadrícula de Ofertas",
  "blocks": [
    {
      "type": "offer_image",
      "name": "Imagen de Oferta",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen (desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagen móvil (opcional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Cuadrícula de Ofertas",
      "blocks": [
        { "type": "offer_image" },
        { "type": "offer_image" },
        { "type": "offer_image" },
        { "type": "offer_image" },
        { "type": "offer_image" }
      ]
    }
  ]
}
{% endschema %}
