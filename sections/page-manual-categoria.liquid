{%- assign cat_blocks = section.blocks | where: 'type', 'category' -%}

<!-- ══ Hero Banner ══ -->
<div class="pmc__hero">
  <div class="pmc__hero-panel" aria-hidden="true"></div>
  <div class="pmc__hero-inner">
    <h1 class="pmc__hero-title" id="pmc-hero-title">&#160;</h1>
  </div>
</div>

<!-- ══ Category data blocks (rendered all, JS shows the matching one) ══ -->
{%- for block in cat_blocks -%}
  {%- assign block_slug = block.settings.slug | downcase | strip -%}
  <div
    class="pmc__category-data"
    data-slug="{{ block_slug }}"
    data-name="{{ block.settings.category_name | escape }}"
    hidden
    {{ block.shopify_attributes }}
  >
    <!-- Description + Image -->
    <div class="pmc__content">
      <div class="pmc__description">
        <div class="pmc__richtext">{{ block.settings.machine_description }}</div>
        {%- if block.settings.manual_pdf_url != blank -%}
          <a class="pmc__pdf-btn" href="{{ block.settings.manual_pdf_url }}" target="_blank" rel="noopener noreferrer">
            DESCARGA AQU&Iacute; EL MANUAL
          </a>
        {%- else -%}
          <span class="pmc__pdf-btn pmc__pdf-btn--disabled" aria-disabled="true">
            DESCARGA AQU&Iacute; EL MANUAL
          </span>
        {%- endif -%}
      </div>
      <div class="pmc__image-col">
        {%- if block.settings.machine_image != blank -%}
          <img src="{{ block.settings.machine_image | image_url: width: 700 }}" alt="{{ block.settings.category_name | escape }}" loading="eager" class="pmc__machine-img">
        {%- else -%}
          <div class="pmc__image-placeholder" aria-hidden="true"></div>
        {%- endif -%}
      </div>
    </div>
    <!-- Videos -->
    <div class="pmc__videos">
      <h2 class="pmc__videos-title">VIDEOS Y TUTORIALES</h2>
      <div class="pmc__videos-grid">
        {%- for i in (1..6) -%}
          {%- assign vid_key = 'video_' | append: i -%}
          {%- assign raw_url = block.settings[vid_key] | strip -%}
          {%- if raw_url != blank -%}
            {%- assign video_id = '' -%}
            {%- if raw_url contains 'youtu.be/' -%}
              {%- assign video_id = raw_url | split: 'youtu.be/' | last | split: '?' | first | strip -%}
            {%- elsif raw_url contains '?v=' -%}
              {%- assign video_id = raw_url | split: '?v=' | last | split: '&' | first | strip -%}
            {%- elsif raw_url contains '&v=' -%}
              {%- assign video_id = raw_url | split: '&v=' | last | split: '&' | first | strip -%}
            {%- endif -%}
            {%- if video_id != blank -%}
              <div class="pmc__video-item">
                <div class="pmc__video-wrapper">
                  <iframe src="https://www.youtube.com/embed/{{ video_id }}" title="{{ block.settings.category_name | escape }} \u2013 Video {{ i }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
                </div>
              </div>
            {%- else -%}
              <div class="pmc__video-item pmc__video-item--soon">
                <div class="pmc__video-soon"><span>PR&Oacute;XIMAMENTE</span></div>
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="pmc__video-item pmc__video-item--soon">
              <div class="pmc__video-soon"><span>PR&Oacute;XIMAMENTE</span></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endfor -%}

<!-- ══ Not found ══ -->
<div class="pmc__not-found" id="pmc-not-found" hidden>
  <p>Categor&iacute;a no encontrada.</p>
</div>

<script>
(function () {
  var params = new URLSearchParams(window.location.search);
  var slug = (params.get('categoria') || '').toLowerCase().trim();
  var blocks = document.querySelectorAll('.pmc__category-data');
  var heroTitle = document.getElementById('pmc-hero-title');
  var found = false;
  blocks.forEach(function (b) {
    if (b.dataset.slug === slug) {
      b.removeAttribute('hidden');
      if (heroTitle) heroTitle.textContent = b.dataset.name || slug.toUpperCase();
      found = true;
    }
  });
  if (!found) {
    var nf = document.getElementById('pmc-not-found');
    if (nf) nf.removeAttribute('hidden');
    if (heroTitle) heroTitle.textContent = slug ? slug.toUpperCase() : 'MANUALES';
  }
})();
</script>

<style>
  /* ══ CSS custom properties ══ */
  .pmc__hero,
  .pmc__category-data,
  .pmc__not-found {
    --pmc-black:    #111111;
    --pmc-navy:     #17306D;
    --pmc-blue:     #183477;
    --pmc-white:    #ffffff;
    --pmc-radius:   8px;
    --pmc-max-w:    1200px;
  }

  /* ══ Hero ══ */
  .pmc__hero {
    position: relative;
    min-height: 90px;
    display: flex;
    align-items: center;
    background: var(--pmc-black);
    overflow: hidden;
  }

  /* Right-side navy panel with diagonal left edge via clip-path */
  .pmc__hero-panel {
    position: absolute;
    inset: 0;
    background: var(--pmc-navy);
    clip-path: polygon(62% 0%, 100% 0%, 100% 100%, 74% 100%);
    z-index: 0;
  }

  .pmc__hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--pmc-max-w);
    margin: 0 auto;
    padding: 1.2rem 2rem;
  }

  .pmc__hero-title {
    font-size: clamp(1.4rem, 3.5vw, 2.2rem);
    font-weight: 900;
    color: var(--pmc-white);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.1;
    max-width: 65%;
  }

  /* ══ Content: description + image ══ */
  .pmc__content {
    display: flex;
    gap: 3rem;
    padding: 2rem 2rem 1.5rem;
    max-width: var(--pmc-max-w);
    margin: 0 auto;
    background: var(--pmc-white);
    align-items: center;
  }

  .pmc__description {
    flex: 0 0 52%;
    max-width: 52%;
  }

  .pmc__richtext {
    font-size: 0.88rem;
    line-height: 1.65;
    color: #333333;
    margin-bottom: 1.25rem;
  }

  .pmc__richtext p  { margin-bottom: 0.7em; }
  .pmc__richtext ul,
  .pmc__richtext ol { padding-left: 1.3em; margin-bottom: 0.7em; }
  .pmc__richtext li { margin-bottom: 0.25em; }

  /* Outlined CTA button — matches reference */
  .pmc__pdf-btn {
    display: inline-block;
    padding: 0.6em 1.4em;
    background: var(--pmc-blue);
    color: var(--pmc-white);
    border: 2px solid var(--pmc-blue);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .pmc__pdf-btn:hover,
  .pmc__pdf-btn:focus-visible {
    background: var(--pmc-navy);
    border-color: var(--pmc-navy);
    color: var(--pmc-white);
    outline: none;
  }

  .pmc__pdf-btn--disabled {
    opacity: 0.45;
    cursor: default;
    pointer-events: none;
  }

  .pmc__video-soon {
    aspect-ratio: 16 / 9;
    background: var(--pmc-navy);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--pmc-radius);
  }

  .pmc__video-soon span {
    color: var(--pmc-white);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .pmc__image-col {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .pmc__machine-img {
    width: 100%;
    max-height: 420px;
    object-fit: contain;
    display: block;
  }

  .pmc__image-placeholder {
    width: 100%;
    height: 280px;
    background: #f0f0f0;
    border-radius: var(--pmc-radius);
  }

  /* ══ Videos ══ */
  .pmc__videos {
    padding: 1.5rem 2rem 2.5rem;
    max-width: var(--pmc-max-w);
    margin: 0 auto;
    background: var(--pmc-white);
  }

  .pmc__videos-title {
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 900;
    color: var(--pmc-blue);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  .pmc__videos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* 16:9 aspect-ratio wrapper */
  .pmc__video-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: var(--pmc-radius);
  }

  .pmc__video-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    border-radius: var(--pmc-radius);
  }

  /* ══ Responsive ══ */
  @media (max-width: 900px) {
    .pmc__hero-title {
      max-width: 75%;
    }

    .pmc__content {
      flex-direction: column;
    }

    .pmc__description {
      flex: 1 1 100%;
      max-width: 100%;
    }

    .pmc__image-col {
      width: 100%;
      padding: 0;
    }

    .pmc__videos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .pmc__hero-panel {
      clip-path: polygon(45% 0%, 100% 0%, 100% 100%, 58% 100%);
    }

    .pmc__hero-title {
      max-width: 100%;
      font-size: clamp(1.5rem, 7vw, 2rem);
    }

    .pmc__content {
      padding: 1.5rem 1rem;
      gap: 1.5rem;
    }

    .pmc__videos {
      padding: 0 1rem 2rem;
    }

    .pmc__videos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Manual \u2013 Categor\u00eda",
  "blocks": [
    {
      "type": "category",
      "name": "Categor\u00eda",
      "settings": [
        {
          "type": "text",
          "id": "slug",
          "label": "Slug (par\u00e1metro URL)",
          "info": "Debe coincidir con el valor de ?categoria= en la URL. Ej: desbrozadoras",
          "default": "mi-categoria"
        },
        {
          "type": "text",
          "id": "category_name",
          "label": "Nombre de la categor\u00eda",
          "default": "NOMBRE DE CATEGOR\u00cdA"
        },
        {
          "type": "richtext",
          "id": "machine_description",
          "label": "Descripci\u00f3n",
          "default": "<p>Descripci\u00f3n de la m\u00e1quina o categor\u00eda.</p>"
        },
        {
          "type": "url",
          "id": "manual_pdf_url",
          "label": "URL del manual PDF"
        },
        {
          "type": "image_picker",
          "id": "machine_image",
          "label": "Imagen de la m\u00e1quina"
        },
        { "type": "text", "id": "video_1", "label": "Video 1 (URL YouTube)" },
        { "type": "text", "id": "video_2", "label": "Video 2 (URL YouTube)" },
        { "type": "text", "id": "video_3", "label": "Video 3 (URL YouTube)" },
        { "type": "text", "id": "video_4", "label": "Video 4 (URL YouTube)" },
        { "type": "text", "id": "video_5", "label": "Video 5 (URL YouTube)" },
        { "type": "text", "id": "video_6", "label": "Video 6 (URL YouTube)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Manual \u2013 Categor\u00eda"
    }
  ]
}
{% endschema %}
