<section class="page-manuales">

  <div class="page-manuales__header">
    <h1 class="page-manuales__title">{{ section.settings.page_title | escape }}</h1>
    {%- if section.settings.page_subtitle != blank -%}
      <p class="page-manuales__subtitle">
        <span class="page-manuales__subtitle-hl">{{ section.settings.page_subtitle | escape }}</span>
      </p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="page-manuales__grid">
      {%- for block in section.blocks -%}
        {%- assign card_url = block.settings.category_url | default: '#' -%}
        <a
          class="page-manuales__card"
          href="{{ card_url }}"
          aria-label="{{ block.settings.category_title | escape }}"
          {{ block.shopify_attributes }}
        >
          <div class="page-manuales__card-header">
            <h2 class="page-manuales__card-title">{{ block.settings.category_title | escape }}</h2>
          </div>
          <div class="page-manuales__card-body">
            {%- if block.settings.category_image != blank -%}
              <img
                src="{{ block.settings.category_image | image_url: width: 400 }}"
                alt="{{ block.settings.category_title | escape }}"
                loading="lazy"
                class="page-manuales__card-img"
              >
            {%- else -%}
              <div class="page-manuales__card-placeholder" aria-hidden="true"></div>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}

</section>

<style>
  .page-manuales {
    --pm-blue:        #183477;
    --pm-card-border: #d0d5dd;
    --pm-card-radius: 10px;
    --pm-gap:         1.5rem;

    background: #ffffff;
    padding: 2.5rem 1.25rem;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Header ── */
  .page-manuales__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .page-manuales__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: #000000;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }

  .page-manuales__subtitle {
    display: block;
    text-align: center;
  }

  /* Text-marker / highlighter effect — background applied per line on wrap */
  .page-manuales__subtitle-hl {
    display: inline;
    background-color: var(--pm-blue);
    color: #ffffff;
    padding: 0.3em 0.75em;
    font-size: clamp(0.85rem, 1.6vw, 1rem);
    font-weight: 400;
    line-height: 2;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  /* ── Grid ── */
  .page-manuales__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--pm-gap);
  }

  /* ── Card ── */
  .page-manuales__card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1.5px solid var(--pm-card-border);
    border-left: 5px solid var(--pm-blue);
    border-radius: var(--pm-card-radius);
    text-decoration: none;
    overflow: hidden;
    min-height: 260px;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .page-manuales__card:hover,
  .page-manuales__card:focus-visible {
    box-shadow: 0 6px 24px rgba(24, 52, 119, 0.18);
    border-color: #a0aec0;
    outline: none;
  }

  .page-manuales__card-header {
    padding: 1rem 1.25rem 0.6rem;
    text-align: center;
  }

  .page-manuales__card-title {
    font-size: clamp(0.85rem, 1.4vw, 1.05rem);
    font-weight: 900;
    color: var(--pm-blue);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.3;
  }

  .page-manuales__card-body {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem 1.5rem;
  }

  .page-manuales__card-img {
    width: 100%;
    max-height: 185px;
    object-fit: contain;
    display: block;
  }

  .page-manuales__card-placeholder {
    width: 100%;
    height: 160px;
    background: #f5f5f5;
    border-radius: 6px;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .page-manuales__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .page-manuales {
      padding: 1.5rem 1rem;
    }
    .page-manuales__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Manuales – Índice",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Título de la página",
      "default": "MANUALES"
    },
    {
      "type": "text",
      "id": "page_subtitle",
      "label": "Subtítulo",
      "default": "Da click en cualquiera de nuestras máquinas para acceder a la información, catálogos y videos"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Tarjeta de categoría",
      "settings": [
        {
          "type": "text",
          "id": "category_title",
          "label": "Nombre de la categoría",
          "default": "CATEGORÍA"
        },
        {
          "type": "image_picker",
          "id": "category_image",
          "label": "Imagen de la categoría"
        },
        {
          "type": "url",
          "id": "category_url",
          "label": "URL de la categoría"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Manuales – Índice",
      "blocks": [
        { "type": "category_card", "settings": { "category_title": "MOTOSIERRAS" } },
        { "type": "category_card", "settings": { "category_title": "DESBROZADORAS" } },
        { "type": "category_card", "settings": { "category_title": "MOTOCULTORES" } },
        { "type": "category_card", "settings": { "category_title": "MOTOTALADROS" } },
        { "type": "category_card", "settings": { "category_title": "PODADORAS" } },
        { "type": "category_card", "settings": { "category_title": "TRITURADOR" } }
      ]
    }
  ]
}
{% endschema %}
