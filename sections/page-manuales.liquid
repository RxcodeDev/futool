{%- assign category_blocks = sections['hero'].blocks | where: 'type', 'category_card' -%}

<section class="page-manuales">

  <div class="page-manuales__header">
    <h1 class="page-manuales__title">{{ section.settings.page_title | escape }}</h1>
    {%- if section.settings.page_subtitle != blank -%}
      <p class="page-manuales__subtitle">{{ section.settings.page_subtitle | escape }}</p>
    {%- endif -%}
  </div>

  {%- if category_blocks.size > 0 -%}
    <div class="page-manuales__grid">
      {%- for block in category_blocks -%}
        {%- assign card_url = block.settings.link | default: '#' -%}
        <a
          class="page-manuales__card"
          href="{{ card_url }}"
          aria-label="{{ block.settings.title | escape }}"
        >
          <div class="page-manuales__card-header">
            <h2 class="page-manuales__card-title">{{ block.settings.title | escape }}</h2>
          </div>
          <div class="page-manuales__card-body">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 400 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                class="page-manuales__card-img"
              >
            {%- else -%}
              <div class="page-manuales__card-placeholder" aria-hidden="true"></div>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}

</section>

<style>
  .page-manuales {
    --pm-blue:        #183477;
    --pm-card-border: #d0d5dd;
    --pm-card-radius: 10px;
    --pm-gap:         1.5rem;

    background: #ffffff;
    padding: 2.5rem 1.25rem;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Header ── */
  .page-manuales__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .page-manuales__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: #000000;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }

  .page-manuales__subtitle {
    font-size: clamp(0.85rem, 1.6vw, 1rem);
    font-weight: 400;
    color: #000000;
    line-height: 1.6;
    margin: 0;
    text-align: center;
  }

  /* ── Grid ── */
  .page-manuales__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--pm-gap);
  }

  /* ── Card ── */
  .page-manuales__card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1.5px solid var(--pm-card-border);
    border-top: 5px solid var(--pm-blue);
    border-radius: var(--pm-card-radius);
    text-decoration: none;
    overflow: hidden;
    min-height: 260px;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .page-manuales__card:hover,
  .page-manuales__card:focus-visible {
    box-shadow: 0 6px 24px rgba(24, 52, 119, 0.18);
    outline: none;
  }

  .page-manuales__card-header {
    padding: 1rem 1.25rem 0.6rem;
    text-align: center;
  }

  .page-manuales__card-title {
    font-size: clamp(0.85rem, 1.4vw, 1.05rem);
    font-weight: 900;
    color: var(--pm-blue);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.3;
  }

  .page-manuales__card-body {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem 1.5rem;
  }

  .page-manuales__card-img {
    width: 100%;
    max-height: 185px;
    object-fit: contain;
    display: block;
  }

  .page-manuales__card-placeholder {
    width: 100%;
    height: 160px;
    background: #f5f5f5;
    border-radius: 6px;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .page-manuales__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .page-manuales {
      padding: 1.5rem 1rem;
    }
    .page-manuales__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Manuales – Índice",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Título de la página",
      "default": "MANUALES"
    },
    {
      "type": "text",
      "id": "page_subtitle",
      "label": "Subtítulo",
      "default": "Da click en cualquiera de nuestras máquinas para acceder a la información, catálogos y videos"
    }
  ],
  "presets": [
    {
      "name": "Manuales – Índice"
    }
  ]
}
{% endschema %}
